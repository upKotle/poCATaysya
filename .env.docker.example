# Необязательные настройки единого Docker-контейнера с внешним OSRM.
# Запуск: docker compose --env-file .env.docker -f compose.external.yml up --build --wait
SCENIC_OSRM_BASE_URL=https://router.project-osrm.org
SCENIC_OSRM_PROXY_URL=
# Если нужен HTTP-прокси компьютера:
# SCENIC_OSRM_PROXY_URL=http://host.docker.internal:10809
# Прокси должен принимать подключения из Docker-сети, не только с localhost.
