# Локальный OSRM (по умолчанию). Для внешнего личного теста:
# OSRM_BASE_URL=https://router.project-osrm.org
OSRM_BASE_URL=http://localhost:5000

# Необязательный HTTP-прокси для внешнего OSRM.
# Укажите HTTP/mixed порт вашего прокси-клиента, например:
# OSRM_PROXY_URL=http://127.0.0.1:10809
OSRM_PROXY_URL=

# Docker Compose использует локальный OSRM http://osrm:5000.
# Эти настройки относятся к обычному запуску backend без контейнера.
